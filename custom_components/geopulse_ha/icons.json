{
  "entity": {
    "sensor": {
      "activity": {
        "default": "mdi:map-marker-question",
        "state": {
          "stay": "mdi:map-marker",
          "trip": "mdi:car",
          "data_gap": "mdi:map-marker-off",
          "no_data": "mdi:map-marker-off"
        }
      },
      "place": { "default": "mdi:map-marker-radius" },
      "activity_since": { "default": "mdi:clock-start" },
      "activity_duration": { "default": "mdi:timer-outline" },
      "friend_activity": {
        "default": "mdi:map-marker-question",
        "state": { "stay": "mdi:map-marker", "trip": "mdi:car" }
      },
      "friend_activity_duration": { "default": "mdi:timer-outline" },
      "friend_place": { "default": "mdi:map-marker-radius" },
      "trip_distance": { "default": "mdi:map-marker-distance" },
      "today_distance": { "default": "mdi:map-marker-distance" },
      "today_trips": { "default": "mdi:routes" },
      "today_stays": { "default": "mdi:home-map-marker" },
      "today_places": { "default": "mdi:map-marker-multiple" },
      "today_moving_time": { "default": "mdi:timer-sand" },
      "last_point": { "default": "mdi:crosshairs-gps" },
      "ingest_status": {
        "default": "mdi:database-check",
        "state": {
          "rejected": "mdi:database-alert",
          "auth_failed": "mdi:database-lock",
          "no_data": "mdi:database-off",
          "disabled": "mdi:database-off"
        }
      },
      "last_data_received": { "default": "mdi:database-import" },
      "last_sent": { "default": "mdi:upload-network" }
    },
    "binary_sensor": {
      "on_trip": { "default": "mdi:car", "state": { "off": "mdi:car-off" } },
      "tracking": { "default": "mdi:crosshairs-gps" },
      "server": { "default": "mdi:server-network" }
    },
    "event": {
      "activity": { "default": "mdi:map-marker-path" }
    },
    "device_tracker": {
      "friend": { "default": "mdi:account" }
    }
  },
  "services": {
    "backfill": { "service": "mdi:history" },
    "flush_queue": { "service": "mdi:upload" }
  }
}
